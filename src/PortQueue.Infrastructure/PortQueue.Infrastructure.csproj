<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PortQueue.Application\PortQueue.Application.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../database/queries/account.sql" LogicalName="PortQueue.Queries.Account.sql" />
    <EmbeddedResource Include="../../database/queries/manage-account.sql" LogicalName="PortQueue.Queries.ManageAccount.sql" />
    <!-- SQL 的唯一源文件在 database/，构建时嵌入，避免运行时依赖工作目录。 -->
    <EmbeddedResource Include="../../database/queries/appointments.sql" LogicalName="PortQueue.Queries.Appointments.sql" />
    <EmbeddedResource Include="../../database/queries/appointment-detail.sql" LogicalName="PortQueue.Queries.AppointmentDetail.sql" />
    <EmbeddedResource Include="../../database/queries/registration-options.sql" LogicalName="PortQueue.Queries.RegistrationOptions.sql" />
    <EmbeddedResource Include="../../database/queries/overview.sql" LogicalName="PortQueue.Queries.Overview.sql" />
    <EmbeddedResource Include="../../database/queries/anchorages.sql" LogicalName="PortQueue.Queries.Anchorages.sql" />
    <EmbeddedResource Include="../../database/queries/anchorage-queue.sql" LogicalName="PortQueue.Queries.AnchorageQueue.sql" />
    <EmbeddedResource Include="../../database/queries/anchorage-stay.sql" LogicalName="PortQueue.Queries.AnchorageStay.sql" />
    <EmbeddedResource Include="../../database/queries/anchorage-entry-candidates.sql" LogicalName="PortQueue.Queries.AnchorageEntryCandidates.sql" />
    <EmbeddedResource Include="../../database/queries/berth-schedule.sql" LogicalName="PortQueue.Queries.BerthSchedule.sql" />
    <EmbeddedResource Include="../../database/queries/berth-visits.sql" LogicalName="PortQueue.Queries.BerthVisits.sql" />
    <EmbeddedResource Include="../../database/queries/berth-visit.sql" LogicalName="PortQueue.Queries.BerthVisit.sql" />
  </ItemGroup>

</Project>
